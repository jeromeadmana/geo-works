# ---------------------------------------------------------------------------
# geo-works — environment template
# Copy this file to `.env.local` and fill in the values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Aiven Postgres connection URI. Paste the full URI Aiven gives you (should
# include ?sslmode=require). All tables this app creates are prefixed geo_*
# so they cannot collide with other apps on the same shared database.
# Example:
# DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require"
DATABASE_URL=""

# NextAuth (Phase 3). Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Mapbox GL JS public token (Phase 2). Safe to expose in the client.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Cloudinary (Phase 3). Cloud name is exposed to the client; API key + secret
# stay server-side and are used for signed uploads / deletions.
CLOUDINARY_URL=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Public canonical URL (used for sitemaps, OG images). Set to http://localhost:3000
# for local dev and to the production subdomain once deployed.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
